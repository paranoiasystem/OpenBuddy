# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=123456789,987654321

# ─── OpenRouter LLM ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# ─── Google OAuth2 ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: "Web application"
# Authorized redirect URI: http://localhost:3000/auth/google/callback (dev)
#                          https://<your-domain>/auth/google/callback  (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ─── Database ──────────────────────────────────────────────────────────────────
DB_PATH=/data/openbuddy.sqlite

# ─── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Create a tunnel at: https://one.dash.cloudflare.com/
# Copy the token from "cloudflared tunnel run --token <TOKEN>"
# Set GOOGLE_REDIRECT_URI to https://<your-tunnel-domain>/auth/google/callback
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
