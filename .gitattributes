# Normalize line endings to LF everywhere
* text=auto eol=lf

# Force binary treatment for non-text files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.sqlite binary

# Force LF for all source files
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Merge strategy: always take ours for lock file conflicts
package-lock.json merge=ours

# Mark generated files for diff filtering
dist/* linguist-generated=true
coverage/* linguist-generated=true
